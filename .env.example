# VruCare settings template. Copy to .env and fill in real values. NEVER commit .env.
# Values here are safe dummies for local development with docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Data stores (local docker compose defaults) ---
DATABASE_URL=postgres://vrucare:vrucare@127.0.0.1:5432/vrucare
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# --- LLM ---
# eval = local Ollama (repeatable) | serve = hosted, with fallback | stub = fake, for tests and load tests
LLM_MODE=stub
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_SEED=42
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_FALLBACK_MODEL=
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN_S=30

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- Retrieval (benchmark YAML configs override these per run) ---
RETRIEVAL_DENSE_K=25
RETRIEVAL_SPARSE_K=25
RETRIEVAL_FINAL_K=5
RRF_K=60
# Tuned on the dev split in Phase 3. Compared to the top DENSE cosine, never the RRF score (max ~0.033).
MIN_TOP_COSINE=
MIN_DISTINCT_DOCS=2
MAX_ESCALATIONS=1
GRAPH_RECURSION_LIMIT=12

# --- PubMed (NCBI E-utilities) ---
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=vrucare

# --- Public demo protection ---
RATE_LIMIT_PER_IP_PER_HOUR=20
