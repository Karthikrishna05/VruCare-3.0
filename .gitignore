# Secrets — never commit real values (.env.example is the committed template)
.env
.env.*
!.env.example

# Virtual environment — rebuilt by: py -3.13 scaffold.py
.venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Django
staticfiles/
*.sqlite3
*.log

# Corpus PDFs — redistribution terms unchecked. SOURCES.yaml IS committed.
data/corpus/*.pdf

# Planning docs and project logs — kept on the laptop, not published
docs/
meta-documentation/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
